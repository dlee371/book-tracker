# Copy this file to .env and fill in real values.
# Local Homebrew Postgres: postgresql://<your-mac-username>@localhost:5432/book_tracker?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/book_tracker?schema=public"

# Better Auth: signs session cookies. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"
