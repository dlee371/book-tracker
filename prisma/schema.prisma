// Database schema. After editing, run `npm run db:migrate` to create a
// migration and regenerate the Prisma Client.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Authentication (Better Auth). Field names must match what Better Auth
// expects; see node_modules/@better-auth/core/dist/db/get-tables.mjs.
// ---------------------------------------------------------------------------

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions Session[]
  accounts Account[]
  books    Book[]
  notes    Note[]
  tags      Tag[]
  ideas     Idea[]
  ideaLinks IdeaLink[]

  @@map("users")
}

// One row per signed-in browser. The session cookie holds the token.
model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// A way of signing in. For email + password, providerId is "credential" and
// `password` holds the password hash (never the password itself).
model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

// Short-lived tokens (e.g. password reset). Unused for now, but required.
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// ---------------------------------------------------------------------------
// Library
// ---------------------------------------------------------------------------

enum ReadingStatus {
  WANT_TO_READ
  READING
  COMPLETED
  ABANDONED
}

model Book {
  id              String        @id @default(cuid())
  userId          String
  title           String
  author          String
  // Derived from `author` on every save ("Clear, James"); used for sorting.
  // See lib/author-sort.ts.
  authorSort      String
  coverUrl        String?
  description     String?
  genre           String?
  publicationYear Int?
  pageCount       Int?
  status          ReadingStatus @default(WANT_TO_READ)
  // Calendar dates without a time of day, to avoid timezone shifts.
  startedAt       DateTime?     @db.Date
  finishedAt      DateTime?     @db.Date
  rating          Int? // 1–5
  review          String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes       Note[]
  ideaSources IdeaSource[]

  @@index([userId])
  @@map("books")
}

// A note written while reading a specific book. The body is Markdown.
model Note {
  id        String   @id @default(cuid())
  userId    String
  bookId    String
  title     String?
  body      String
  page      Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  book  Book       @relation(fields: [bookId], references: [id], onDelete: Cascade)
  tags  NoteTag[]
  ideas IdeaNote[]

  @@index([bookId])
  @@index([userId])
  @@map("notes")
}

// ---------------------------------------------------------------------------
// Tags
// ---------------------------------------------------------------------------

// Names are stored normalized (lowercase, trimmed; see lib/tags.ts), and each
// user has at most one tag per name.
model Tag {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes NoteTag[]
  ideas IdeaTag[]

  @@unique([userId, name])
  @@map("tags")
}

// Join table: which tags are on which notes (many-to-many). The pair of ids
// is the primary key, so a note can't have the same tag twice.
model NoteTag {
  noteId String
  tagId  String

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
  @@index([tagId])
  @@map("note_tags")
}

// ---------------------------------------------------------------------------
// Ideas: independent pieces of knowledge, which can come from several books.
// ---------------------------------------------------------------------------

model Idea {
  id          String   @id @default(cuid())
  userId      String
  // The idea itself, stated as a claim ("Environment shapes behavior").
  title       String
  // Optional Markdown elaboration.
  explanation String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sources   IdeaSource[]
  notes     IdeaNote[]
  tags      IdeaTag[]
  // Connections to other ideas, split by which end this idea is on.
  linksFrom IdeaLink[]   @relation("LinkFrom")
  linksTo   IdeaLink[]   @relation("LinkTo")

  @@index([userId])
  @@map("ideas")
}

// Which books an idea comes from. Deleting a book removes the link, not the
// idea. Rule (enforced in lib/services/ideas.ts): the book of every
// supporting note is also a source.
model IdeaSource {
  ideaId String
  bookId String

  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@id([ideaId, bookId])
  @@index([bookId])
  @@map("idea_sources")
}

// Notes that support an idea.
model IdeaNote {
  ideaId String
  noteId String

  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@id([ideaId, noteId])
  @@index([noteId])
  @@map("idea_notes")
}

model IdeaTag {
  ideaId String
  tagId  String

  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([ideaId, tagId])
  @@index([tagId])
  @@map("idea_tags")
}

// ---------------------------------------------------------------------------
// Connections between ideas
// ---------------------------------------------------------------------------

enum IdeaLinkType {
  SUPPORTS // from supports to (directional)
  EXTENDS // from builds on to (directional)
  CONTRADICTS // symmetric
  RELATED // symmetric
}

// A typed connection between two of the user's ideas.
// - Symmetric types are stored with the smaller id as fromIdeaId, so the
//   unique constraint also blocks "B-A" when "A-B" exists
//   (see lib/services/idea-links.ts).
// - The migration adds a CHECK constraint so an idea can't link to itself.
model IdeaLink {
  id         String       @id @default(cuid())
  userId     String
  fromIdeaId String
  toIdeaId   String
  type       IdeaLinkType
  comment    String?
  createdAt  DateTime     @default(now())

  user     User @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromIdea Idea @relation("LinkFrom", fields: [fromIdeaId], references: [id], onDelete: Cascade)
  toIdea   Idea @relation("LinkTo", fields: [toIdeaId], references: [id], onDelete: Cascade)

  @@unique([fromIdeaId, toIdeaId, type])
  @@index([toIdeaId])
  @@index([userId])
  @@map("idea_links")
}
